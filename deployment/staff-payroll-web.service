[Unit]
Description=Hidden Oasis Staff Payroll Web
After=network.target staff-payroll-api.service
Wants=staff-payroll-api.service

[Service]
Type=simple
User=staff-payroll
Group=staff-payroll
UMask=0077
WorkingDirectory=/opt/hiddenoasis/staff-payroll/current/apps/web
EnvironmentFile=/etc/hiddenoasis/staff-payroll.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node /opt/hiddenoasis/staff-payroll/current/apps/web/.next/standalone/server.js
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
SendSIGKILL=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=-/opt/hiddenoasis/staff-payroll/current/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
