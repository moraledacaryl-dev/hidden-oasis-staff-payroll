[Unit]
Description=Hidden Oasis Staff Payroll Integration Worker
After=network-online.target staff-payroll-api.service
Wants=network-online.target staff-payroll-api.service

[Service]
Type=simple
User=staff-payroll
Group=staff-payroll
UMask=0077
WorkingDirectory=/opt/hiddenoasis/staff-payroll/current
EnvironmentFile=/etc/hiddenoasis/staff-payroll.env
ExecStart=/opt/hiddenoasis/staff-payroll/current/.venv-api/bin/python scripts/run_integration_worker.py
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hiddenoasis/staff-payroll

[Install]
WantedBy=multi-user.target
