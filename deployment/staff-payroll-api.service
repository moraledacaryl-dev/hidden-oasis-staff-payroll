[Unit]
Description=Hidden Oasis Staff Payroll API
After=network.target

[Service]
Type=simple
User=staff-payroll
Group=staff-payroll
UMask=0077
WorkingDirectory=/opt/hiddenoasis/staff-payroll/current
EnvironmentFile=/etc/hiddenoasis/staff-payroll.env
ExecStart=/opt/hiddenoasis/staff-payroll/current/.venv-api/bin/python -m uvicorn api.server:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hiddenoasis/staff-payroll /var/backups/hidden-oasis-staff-payroll/runtime

[Install]
WantedBy=multi-user.target
