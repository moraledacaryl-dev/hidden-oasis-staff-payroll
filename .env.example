# Core Staff/Payroll application settings
STAFF_PAYROLL_ENV=production
STAFF_PAYROLL_API_KEY=replace-with-long-random-api-key-at-least-32-bytes
STAFF_PAYROLL_SESSION_SECRET=replace-with-different-long-random-session-secret-at-least-32-bytes
STAFF_PAYROLL_MFA_KEY=replace-with-independent-long-random-mfa-encryption-key-at-least-32-bytes
STAFF_PAYROLL_REQUIRE_PRIVILEGED_MFA=true
STAFF_PAYROLL_DB_PATH=/var/lib/hiddenoasis/staff-payroll/staff_payroll.sqlite
STAFF_PAYROLL_CORS_ORIGINS=https://staff.hiddenoasis.app
STAFF_PAYROLL_API_URL=http://127.0.0.1:8001
PUBLIC_APP_URL=https://staff.hiddenoasis.app
APP_BASE_PATH=/staff
STAFF_PAYROLL_API_BASE_URL=https://staff.hiddenoasis.app

# Durable integration outbox worker
STAFF_PAYROLL_SYNC_INTERVAL_SECONDS=10
STAFF_PAYROLL_SYNC_BATCH_SIZE=25

# Destination-specific URLs and secrets. Keep destinations blank until their receiver is deployed.
STAFF_PAYROLL_ACCOUNTING_SYNC_URL=https://accounting.hiddenoasis.app
STAFF_PAYROLL_ACCOUNTING_SYNC_TOKEN=replace-with-accounting-specific-secret

STAFF_PAYROLL_OPERATIONS_SYNC_URL=https://operations.hiddenoasis.app
STAFF_PAYROLL_OPERATIONS_SYNC_TOKEN=replace-with-operations-specific-secret

STAFF_PAYROLL_POS_SYNC_URL=https://pos.hiddenoasis.app
STAFF_PAYROLL_POS_SYNC_TOKEN=replace-with-pos-specific-secret

STAFF_PAYROLL_INVENTORY_SYNC_URL=https://inventory.hiddenoasis.app
STAFF_PAYROLL_INVENTORY_SYNC_TOKEN=replace-with-inventory-specific-secret

# Legacy compatibility values retained while older integration controls are retired.
ACCOUNTING_API_BASE_URL=https://accounting.hiddenoasis.app/api
POS_API_BASE_URL=https://pos.hiddenoasis.app/api
OPERATIONS_API_BASE_URL=https://operations.hiddenoasis.app/api
STAFF_PAYROLL_EXTERNAL_SOURCE=hidden_oasis_staff_payroll
INTEGRATION_API_KEY=replace-with-legacy-shared-secret
ALLOWED_ORIGINS=https://hiddenoasis.app,https://staff.hiddenoasis.app
CORS_ORIGINS=https://hiddenoasis.app,https://staff.hiddenoasis.app
